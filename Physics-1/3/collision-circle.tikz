\begingroup
\begin{tikzpicture}[font=\small,line width=0.6pt,
  collision/.style={->,>=latex,blue!60!black},
  wall/.style={->,>=latex,gray!75,dashed}]
  \begin{scope}
    \draw[gray!55,->] (-2.35,0) -- (2.45,0) node[right] {$X$};
    \draw[gray!55,->] (0,-2.20) -- (0,2.45) node[above] {$Y$};
    \draw[gray!75] (0,0) circle[radius=1.8];
    \foreach \n/\angle in {0/90,1/62,2/118} {
      \coordinate (p\n) at (\angle:1.8);
    }
    \draw[collision] (p0) -- (p1);
    \draw[wall] (p1) -- (p2);
    \draw[gray!65] (0,0) -- (p1);
    \draw[->,gray!75] (0,0.70) arc[start angle=90,end angle=62,radius=0.70];
    \node at (76:0.98) {$\theta$};
    \foreach \n/\angle in {0/90,1/62,2/118} {
      \fill[blue!60!black] (p\n) circle[radius=1.5pt];
      \node at (\angle:2.08) {$\n$};
    }
    \node at (0,-2.65) {First two collisions};
  \end{scope}

  \begin{scope}[xshift=6.1cm]
    \draw[gray!55,->] (-2.35,0) -- (2.45,0) node[right] {$X$};
    \draw[gray!55,->] (0,-2.20) -- (0,2.45) node[above] {$Y$};
    \draw[gray!75] (0,0) circle[radius=1.8];
    \foreach \n/\angle in {
      0/90,1/62,2/118,3/34,4/146,5/6,6/174,
      7/-22,8/202,9/-50,10/230} {
      \coordinate (q\n) at (\angle:1.8);
    }
    \foreach \n in {1,3,5,7,9} {
      \pgfmathtruncatemacro{\previous}{\n-1}
      \draw[collision] (q\previous) -- (q\n);
    }
    \foreach \n in {2,4,6,8,10} {
      \pgfmathtruncatemacro{\previous}{\n-1}
      \draw[wall] (q\previous) -- (q\n);
    }
    \foreach \n/\angle in {
      0/90,1/62,2/118,3/34,4/146,5/6,6/174,
      7/-22,8/202,9/-50,10/230} {
      \fill[blue!60!black] (q\n) circle[radius=1.5pt];
      \node at (\angle:2.08) {$\n$};
    }
    \node at (0,-2.20) {$\cdots$};
    \node at (0,-2.65) {Subsequent collisions};
  \end{scope}
\end{tikzpicture}
\endgroup
