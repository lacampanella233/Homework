% AI-assisted TikZ redraw of sand-conveyor.png; no additional physical information.
\begingroup
\usetikzlibrary{arrows.meta}
\begin{tikzpicture}[x=1cm,y=1cm,line join=round,line cap=round]
  \definecolor{conveyorsand}{RGB}{232,199,143}
  \definecolor{conveyorgrain}{RGB}{183,144,84}
  \definecolor{conveyorforce}{RGB}{17,111,174}

  % Hopper: its exterior is transparent; the interior above the sand is grey.
  \path[fill=gray!16,draw=gray!55,line width=1.1pt]
    (0.45,4.0) -- (3.65,4.0) -- (3.65,3.15)
    -- (2.14,1.72) -- (2.14,0.62) -- (1.96,0.62)
    -- (1.96,1.72) -- (0.45,3.15) -- cycle;
  \begin{scope}
    \clip (0.58,3.78) -- (2.05,3.18) -- (3.52,3.78)
      -- (3.52,3.20) -- (2.05,1.81) -- (0.58,3.20) -- cycle;
    \fill[conveyorsand!55] (0.5,1.7) rectangle (3.6,3.9);
    \pgfmathsetseed{7319}
    \foreach \grain in {1,...,620} {
      \pgfmathsetmacro{\grainx}{0.58+2.94*rnd}
      \pgfmathsetmacro{\grainy}{1.81+1.97*rnd}
      \fill[conveyorgrain!65] (\grainx,\grainy) circle[radius=0.010];
    }
  \end{scope}
  \draw[gray!35,line width=0.45pt]
    (0.58,3.96) -- (0.58,3.20) -- (2.05,1.81)
    -- (3.52,3.20) -- (3.52,3.96);

  % Sand descends through the narrow outlet onto the moving belt.
  \draw[conveyorsand,line width=0.65pt] (2.05,1.81) -- (2.05,0.13);
  \foreach \y in {0.20,0.29,0.39,0.47,0.56} {
    \fill[conveyorgrain!70] (2.04,\y) circle[radius=0.012];
  }
  \path[fill=conveyorsand!80]
    (2.02,0.10) -- (2.09,0.16) -- (2.40,0.12)
    -- (3.0,0.14) -- (3.7,0.12) -- (4.5,0.14)
    -- (5.2,0.12) -- (6.0,0.14) -- (6.8,0.12)
    -- (7.8,0.14) -- (7.8,0.08) -- cycle;

  % Seven supporting rollers and the straight upper run of the belt.
  \foreach \x in {0.20,1.40,2.60,3.80,5.00,6.20,7.40} {
    \path[fill=gray!18,draw=gray!65,line width=0.7pt]
      (\x,-0.13) circle[radius=0.15];
    \draw[gray!55,line width=0.45pt] (\x,-0.13) circle[radius=0.075];
    \fill[gray!65] (\x,-0.13) circle[radius=0.025];
  }
  \draw[gray!70,line width=2.0pt] (0,0.07) -- (7.8,0.07);

  \draw[-{Latex[length=2.8mm,width=2.1mm]},red!80!black,line width=1.25pt]
    (4.35,0.53) -- (5.30,0.53);
  \node[above,text=gray!75!black] at (4.78,0.58) {$v$};
  \draw[-{Latex[length=3.6mm,width=2.7mm]},conveyorforce,line width=1.9pt]
    (7.80,0.07) -- (9.90,0.07);
  \node[above,text=conveyorforce] at (8.82,0.30) {$\vec F_{\mathrm{ext}}$};
\end{tikzpicture}
\endgroup
