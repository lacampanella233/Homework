\begin{tikzpicture}[homework diagram, x=1cm, y=1.5cm]
  % Match the schematic horizontal spacing of the force plot.
  \path[use as bounding box] (-2,-1.65) rectangle (6.4,.7);
  \draw[->] (0,-1.55) -- (0,.35) node[above] {$U(r)$};
  \draw[->] (0,0) -- (6,0) node[right] {$r$};
  \node[above left] at (0,0) {$0$};
  \node[above] at (1,0) {$b$};
  \node[above] at (2,0) {$a$};
  \node[below left] at (0,{-9/7}) {$U(b)$};
  \node[left] at (0,-1) {$-\dfrac{GMm}{a}$};
  \draw[dashed, gray] (1,0) -- (1,{-9/7});
  \draw[dashed, gray] (0,-1) -- (2,-1) -- (2,0);
  \draw[line width=1pt] (0,{-9/7}) -- (1,{-9/7});
  \draw[line width=1pt, domain=1:2, samples=40]
    plot (\x,{-(12-\x*\x-2/\x)/7});
  \draw[->, line width=1pt, domain=2:5.6, samples=60]
    plot (\x,{-2/\x});
\end{tikzpicture}
